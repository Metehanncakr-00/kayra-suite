{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KAYRA Suite",
  "version": "1.0.4",
  "identifier": "com.kayrastudio.suite",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "KAYRA Suite - Creative Hub",
        "url": "index.html",
        "width": 1440,
        "height": 920,
        "decorations": true,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "installer.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhDMzE0NTlEREI5MkU1NUYKUldSZjVaTGJuVVV4akxiZGxhNXZhcHowNGJCTTlEMnZEdHhhZUVGUVEzQzY4aTgrY1FvejA0WmEK",
      "endpoints": [
        "https://github.com/Metehanncakr-00/kayra-suite/releases/latest/download/latest.json"
      ]
    }
  }
}